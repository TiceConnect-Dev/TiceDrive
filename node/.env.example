APP_NAME=Espace Documents
APP_URL=https://drive.exemple.fr
HOST_PORT=8290

# OnlyOffice Docs (facultatif) : même adresse et même secret JWT que le serveur OnlyOffice
ONLYOFFICE_URL=https://office.exemple.fr
ONLYOFFICE_JWT_SECRET=secret_jwt_onlyoffice

# Facultatif : adresse du drive vue depuis OnlyOffice (même réseau Docker)
APP_INTERNAL_URL=

# Secret des sessions : openssl rand -hex 48
SECRET=changez-moi

# Compte administrateur créé au premier démarrage
ADMIN_EMAIL=admin@exemple.fr
ADMIN_PASSWORD=changez-moi-aussi

DEFAULT_QUOTA=10G
MAX_UPLOAD=4G
MAX_VERSIONS=20
TRASH_DAYS=30
ALLOW_SIGNUP=false
